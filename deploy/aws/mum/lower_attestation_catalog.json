          "c",
          "CHECK (((reserved_row_sha256 ~ '^[0-9a-f]{64}$'::text) AND (request_sha256 ~ '^[0-9a-f]{64}$'::text) AND (challenge ~ '^[0-9a-f]{64}$'::text) AND ((evidence_sha256 IS NULL) OR (evidence_sha256 ~ '^[0-9a-f]{64}$'::text)) AND ((marker_sha256 IS NULL) OR (marker_sha256 ~ '^[0-9a-f]{64}$'::text)) AND ((measured_digest IS NULL) OR (measured_digest ~ '^sha256:[0-9a-f]{64}$'::text))))",
          true,
          false
        ],
        [
