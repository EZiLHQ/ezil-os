        [
          "ezil_computer_lower_attestations_failure_check",
          "c",
          "CHECK (((failure_code IS NULL) OR (failure_code = ANY (ARRAY['command_invalid'::text, 'source_not_pinned'::text, 'receipt_invalid'::text, 'marker_mismatch'::text, 'mount_not_readonly'::text, 'identity_invalid'::text, 'untrusted_ami'::text, 'snapshot_lineage_mismatch'::text, 'clone_lineage_mismatch'::text, 'original_not_fenced'::text, 'launch_tuple_invalid'::text, 'release_mismatch'::text, 'instance_provenance_missing'::text, 'placement_changed'::text, 'reservation_expired'::text, 'operator_abandoned'::text]))))",
