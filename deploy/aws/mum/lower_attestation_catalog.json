        ],
        [
          "ezil_computer_lower_attestations_sealed_check",
          "c",
          "CHECK ((((phase = 'reserved'::text) AND (failure_code IS NULL) AND (completed_at IS NULL) AND (num_nonnulls(command_id, evidence, evidence_sha256, measured_digest, measured_at, marker_sha256, snapshot_id, clone_volume_id, maintenance_instance_id, maintenance_ami_id, source_release) = 0)) OR ((phase = 'adopted'::text) AND (failure_code IS NULL) AND (completed_at IS NOT NULL) AND (num_nulls(command_id, evidence, evidence_sha256, measured_digest, measured_at, marker_sha256, snapshot_id, clone_volume_id, maintenance_instance_id, maintenance_ami_id, source_release) = 0)) OR ((phase = 'refused'::text) AND (failure_code IS NOT NULL) AND (completed_at IS NOT NULL) AND (num_nonnulls(command_id, evidence, evidence_sha256, measured_digest, measured_at, marker_sha256, snapshot_id, clone_volume_id, maintenance_instance_id, maintenance_ami_id, source_release) = 0))))",
          true,
          false
        ],
        [
          "ezil_computer_lower_attestations_time_check",
          "c",
