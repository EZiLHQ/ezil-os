# Dependencies
# `node_modules` without a trailing slash: worktrees carry node_modules as SYMLINKS to the main tree, and a
# directory-only pattern (trailing slash) would leave every symlink showing as untracked in every worktree.
node_modules

# Build output (except intentionally-committed, pre-built bundles that
# something downstream consumes without a toolchain)
dist/
dist-ssr/
dist-electron/
# ...the workspace bootstrap the Docker image COPYs at build time
!worker/bootstrap/dist
!worker/bootstrap/dist/workspace-bootstrap.mjs
# ...and the browser shell bundle Next.js serves statically. Generated by
# shell/build-shell.sh but committed, so the app needs no shell build step and
# so `shell/build-shell.sh --check` has a committed artifact to diff against.
!app/public/os/
!app/public/os/**
app/.next/
app/next-env.d.ts
app/tsconfig.tsbuildinfo

# Test reports written INTO the checkout rather than into a temp directory.
# `.github/workflows/ci.yml`'s worker job runs
# `bun test --reporter=junit --reporter-outfile=worker-junit.xml` with
# `working-directory: worker`, so the report lands at `worker/worker-junit.xml`
# on all three runners. The path is relative on purpose (row M4): bun is a
# native Windows binary and resolves `/tmp/x` against the current drive, while
# the evidence step that greps the report runs under Git Bash's MSYS, which
# maps `/tmp` into the user's temp directory — the two do not agree on `/tmp`,
# and they do agree on a relative path. Relative means it is inside the working
# tree, so it needs ignoring; `*.log` above does not cover an `.xml`.
worker/worker-junit.xml

# Env / secrets — never commit these
.env
.env.production
.env.development
.env.test
.env.local
.env.development.local
.env.test.local
.env.production.local
# wrangler's local secrets file (the Worker's .env.local)
.dev.vars
.dev.vars.*
# ...except the checked-in, names-only template
!.env.example

# Cloudflare Workers local runtime state (wrangler dev)
.wrangler/
.wrangler/state/
.wrangler/tmp/

# OS / editor cruft
.DS_Store
*.log
# Agent definitions are COMMITTED (transparency: the models, effort levels and
# mandatory rules every worker runs under are part of the public record).
# Worktrees and any other per-machine agent state stay ignored. A trailing-slash
# `.claude/` rule would stop git descending and no negation could rescue it.
.claude/*
!.claude/agents/
.claude/worktrees/

# Local agent/tunnel state — machine-specific, never publishable
.openclaw-forwards.json
