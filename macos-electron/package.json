{
  "name": "ezil-native-mac",
  "version": "0.1.1",
  "private": true,
  "description": "EZiL OS trusted native Apple Silicon host",
  "main": "src/main.cjs",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "test": "node --test --test-isolation=none test/*.test.cjs",
    "check": "node scripts/check.cjs",
    "start": "electron .",
    "test:electron": "electron test/electron-smoke.cjs",
    "test:browser-tabs": "node test/browser-tabs-flow.cjs",
    "test:passkeys": "node test/passkeys-flow.cjs",
    "package:internal": "node scripts/package.cjs",
    "package:release": "node scripts/package.cjs --developer-id"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "playwright-core": "1.62.1"
  },
  "ezilTools": {
    "bun": "1.3.14",
    "node": "24.15.0",
    "npm": "11.12.1"
  }
}
