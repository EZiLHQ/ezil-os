{
  "schemaVersion": "2.2",
  "description": "Operate an authorized computer supervisor start through the fixed root manager",
  "parameters": {
    "Operation": {
      "type": "String",
      "description": "Base64 of the bounded versioned startup operation; no keys, credentials or shell commands",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[A-Za-z0-9+/]{1,21846}={0,2}$"
    }
  },
  "mainSteps": [{
    "action": "aws:runShellScript",
    "name": "operateStart",
    "precondition": { "StringEquals": ["platformType", "Linux"] },
    "inputs": {
      "timeoutSeconds": "150",
      "runCommand": ["/usr/local/bin/node /opt/ezil-supervisor/current/dist/start-operation.js"]
    }
  }]
}
