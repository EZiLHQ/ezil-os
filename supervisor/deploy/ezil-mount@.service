[Unit]
Description=EZiL bounded computer data mount
After=network-online.target

[Service]
Type=exec
User=root
Group=root
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/node /opt/ezil-supervisor/current/dist/mount-executor.js %i
StandardOutput=null
StandardError=null
RuntimeMaxSec=15min
TimeoutStopSec=10
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
Restart=no
