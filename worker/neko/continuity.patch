+// Relay delivery is bounded and reports write failure, unlike broadcast Send.
+func (session *SessionCtx) SendRelay(event string,payload any,deadline time.Time) error {
+ session.websocketMu.Lock()
+ peer:=session.websocketPeer
+ session.websocketMu.Unlock()
+ sender,ok:=peer.(interface { SendBefore(string,any,time.Time) error })
+ if !ok { return fmt.Errorf("relay viewer disconnected") }
+ return sender.SendBefore(event,payload,deadline)
+}
