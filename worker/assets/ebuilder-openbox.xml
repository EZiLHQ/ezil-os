<?xml version="1.0" encoding="UTF-8"?>
<!--
  EZiL OS — explicit, testable Openbox configuration for the neko desktop.

  The pinned neko image's /etc/neko/openbox.xml has NO keyboard section and NO
  root menu, so app-switching there relied entirely on out-of-band wmctrl calls
  and was unproven. This config makes the desktop's window management explicit
  and machine-checkable:

    * Keyboard shortcuts that switch between the two mandatory apps by invoking
      the same deterministic /usr/local/bin/neko-switch-app.sh helper the
      validators use, plus a standard Alt-Tab window cycle.
    * An explicit root menu (ebuilder-menu.xml) with entries to focus either
      app, so the desktop is usable and the menu is provably present.

  validate-neko-desktop.sh asserts this file is the live Openbox rc AND that it
  contains the expected keybind/menu wiring, so "shortcuts + root menu exist"
  becomes positive evidence rather than an assumption.

  NOTE (code-server swap): Electron VS Code was removed from this image and
  replaced by code-server, a plain HTTP server with no X window at all. The
  <application class="Code"> rule below and the W-1/W-c keybinds that invoke
  `neko-switch-app.sh vscode` are therefore now permanently inert — no window
  will ever match `class="Code"`, and the keybinds resolve to a confirmed,
  verified no-op (see neko-switch-app.sh's own comment on the `vscode` case).
  Left in place rather than deleted since an inert rule/keybind is harmless
  and Openbox does not error on an unmatched `<application>` selector or a
  keybind whose command exits non-zero.
-->
<openbox_config xmlns="http://openbox.org/3.4/rc">

<applications>
  <!-- Inert since the code-server swap (see NOTE above) — no window will ever
       have class="Code" now that VS Code Electron is gone. Kept for a clean
       rollback path; matches nothing, does nothing. -->
  <application type="normal" class="Code">
    <decor>no</decor>
    <maximized>true</maximized>
    <focus>yes</focus>
    <layer>normal</layer>
  </application>
  <!-- The mandatory native browser (Google Chrome). Maximize + focus so its
       window is a full, focusable top-level surface. -->
  <application type="normal" class="Google-chrome">
    <decor>no</decor>
    <maximized>true</maximized>
    <focus>yes</focus>
    <layer>normal</layer>
  </application>
</applications>

<focus>
  <focusNew>yes</focusNew>
  <followMouse>no</followMouse>
  <focusLast>yes</focusLast>
</focus>

<placement>
  <policy>Smart</policy>
  <center>yes</center>
  <monitor>Primary</monitor>
</placement>

<keyboard>
  <!-- Explicit, deterministic app-switch shortcuts. Both invoke the same
       helper the validators drive, so the bound key and the tested code path
       are identical.
       W-1/W-c ("vscode") are inert since the code-server swap: verified
       no-op, see the NOTE at the top of this file and neko-switch-app.sh's
       own comment. Kept rather than removed/rebound for a clean rollback
       path and because a keybind whose command exits non-zero is harmless. -->
  <keybind key="W-1">
    <action name="Execute"><command>/usr/local/bin/neko-switch-app.sh vscode</command></action>
  </keybind>
  <keybind key="W-2">
    <action name="Execute"><command>/usr/local/bin/neko-switch-app.sh chromium</command></action>
  </keybind>
  <keybind key="W-c">
    <action name="Execute"><command>/usr/local/bin/neko-switch-app.sh vscode</command></action>
  </keybind>
  <keybind key="W-e">
    <action name="Execute"><command>/usr/local/bin/neko-switch-app.sh chromium</command></action>
  </keybind>
  <!-- Standard window cycling. -->
  <keybind key="A-Tab">
    <action name="NextWindow"/>
  </keybind>
  <keybind key="A-S-Tab">
    <action name="PreviousWindow"/>
  </keybind>
</keyboard>

<menu>
  <file>/etc/neko/ebuilder-menu.xml</file>
</menu>

<mouse>
  <context name="Root">
    <mousebind button="Right" action="Press">
      <action name="ShowMenu"><menu>root-menu</menu></action>
    </mousebind>
  </context>
</mouse>

</openbox_config>
