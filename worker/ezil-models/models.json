{
  "$schema": "https://raw.githubusercontent.com/EZiLHQ/ezil-os/main/extensions/ezil-models/schema/models.schema.json",
  "$comment": "EZiL AI only. The chat calls ai.ezil.work through this computer's Worker proxy (docs/AI-GATEWAY.md); the Worker injects EZIL_AI_BASE_URL and the per-computer EZIL_AI_PROXY_TOKEN at boot. No provider key is in the image or the container. Direct-provider configs (Anthropic, Foundry, OpenAI) stay supported: see extensions/ezil-models/examples/models.example.json.",
  "providers": {
    "ezil": {
      "type": "ezil-gateway",
      "baseUrl": "{env:EZIL_AI_BASE_URL}",
      "apiKey": "{env:EZIL_AI_PROXY_TOKEN}"
    }
  },
  "defaults": {
    "capabilities": {
      "toolCalling": true,
      "imageInput": false
    }
  },
  "models": [
    {
      "id": "ezil-code",
      "name": "EZiL Code",
      "provider": "ezil",
      "model": "ezil-code",
      "detail": "EZiL AI coding model (credits)",
      "maxInputTokens": 16384,
      "maxOutputTokens": 4096,
      "default": true,
      "roles": [
        "default",
        "plan"
      ]
    },
    {
      "id": "ezil-fast",
      "name": "EZiL Fast",
      "provider": "ezil",
      "model": "ezil-fast",
      "detail": "EZiL AI utility model (credits)",
      "maxInputTokens": 32768,
      "maxOutputTokens": 8192,
      "roles": [
        "utility",
        "utilitySmall"
      ]
    }
  ]
}
