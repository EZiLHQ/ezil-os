{
  "$schema": "https://raw.githubusercontent.com/EZiLHQ/ezil-os/main/extensions/ezil-models/schema/models.schema.json",
  "providers": {
    "anthropic": {
      "type": "anthropic",
      "apiKey": "{env:ANTHROPIC_API_KEY}"
    },
    "foundry-anthropic": {
      "type": "anthropic-foundry",
      "resource": "{env:AZURE_RESOURCE_NAME}",
      "apiKey": "{env:AZURE_API_KEY}"
    },
    "foundry-openai": {
      "type": "azure-openai",
      "resource": "{env:AZURE_RESOURCE_NAME}",
      "apiKey": "{env:AZURE_API_KEY}"
    },
    "openai": {
      "type": "openai",
      "apiKey": "{env:OPENAI_API_KEY}"
    }
  },
  "defaults": {
    "capabilities": {
      "toolCalling": true,
      "imageInput": true
    }
  },
  "models": [
    {
      "id": "claude-opus-5-5",
      "name": "Claude Opus 5.5",
      "provider": "anthropic",
      "model": "claude-opus-5-5",
      "family": "claude",
      "maxInputTokens": 200000,
      "maxOutputTokens": 128000,
      "thinking": {
        "type": "adaptive",
        "effort": "medium",
        "display": "summarized"
      },
      "cache": {
        "ttl": "5m"
      },
      "default": true,
      "roles": [
        "default",
        "plan"
      ]
    },
    {
      "id": "claude-sonnet-5",
      "name": "Claude Sonnet 5",
      "provider": "anthropic",
      "model": "claude-sonnet-5",
      "family": "claude",
      "maxInputTokens": 200000,
      "maxOutputTokens": 64000,
      "thinking": {
        "type": "adaptive",
        "effort": "high",
        "display": "summarized"
      },
      "cache": {
        "ttl": "5m"
      }
    },
    {
      "id": "claude-fable-5-1",
      "name": "Claude Fable 5.1",
      "provider": "anthropic",
      "model": "claude-fable-5-1",
      "family": "claude",
      "maxInputTokens": 200000,
      "maxOutputTokens": 64000,
      "thinking": {
        "type": "adaptive",
        "effort": "medium",
        "display": "summarized"
      },
      "cache": {
        "ttl": "5m"
      }
    },
    {
      "id": "claude-haiku-4-5",
      "name": "Claude Haiku 4.5",
      "provider": "anthropic",
      "model": "claude-haiku-4-5",
      "family": "claude",
      "maxInputTokens": 200000,
      "maxOutputTokens": 32000,
      "thinking": {
        "type": "enabled",
        "budgetTokens": 4096
      },
      "roles": [
        "utility",
        "utilitySmall"
      ]
    },
    {
      "id": "foundry-claude-sonnet-5",
      "name": "Claude Sonnet 5 (Foundry)",
      "provider": "foundry-anthropic",
      "model": "claude-sonnet-5",
      "family": "claude",
      "detail": "Microsoft Foundry deployment; `model` is the deployment name",
      "maxInputTokens": 200000,
      "maxOutputTokens": 64000,
      "thinking": {
        "type": "adaptive",
        "effort": "high",
        "display": "summarized"
      },
      "cache": {
        "ttl": "1h"
      }
    },
    {
      "id": "foundry-gpt-4-1",
      "name": "GPT-4.1 (Foundry)",
      "provider": "foundry-openai",
      "model": "gpt-4.1",
      "family": "gpt",
      "detail": "Example Foundry OpenAI deployment; `model` is the deployment name",
      "maxInputTokens": 1000000,
      "maxOutputTokens": 32768
    },
    {
      "id": "foundry-gpt-5",
      "name": "GPT-5 (Foundry)",
      "provider": "foundry-openai",
      "model": "gpt-5",
      "family": "gpt",
      "detail": "Example Foundry OpenAI deployment; `model` is the deployment name",
      "maxInputTokens": 272000,
      "maxOutputTokens": 32768,
      "thinking": {
        "type": "adaptive",
        "effort": "medium"
      }
    },
    {
      "id": "gpt-5",
      "name": "GPT-5",
      "provider": "openai",
      "model": "gpt-5",
      "family": "gpt",
      "maxInputTokens": 272000,
      "maxOutputTokens": 32768,
      "thinking": {
        "type": "adaptive",
        "effort": "medium"
      }
    }
  ]
}
