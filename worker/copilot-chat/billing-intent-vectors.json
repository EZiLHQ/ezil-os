      "expect": { "reason": "window_limit", "requestId": "6f1d3a52-9b0e-4c1d-8a7b-2e5f4d3c2b1a" } },
    { "record": { "reason": "window_limit", "requestId": "6f1d3a52-9b0e-4c1d-8a7b-2e5f4d3c2b1a", "resetsAt": "2026-11-09T21:05:33.123Z" },
