    { "record": { "reason": "model_locked", "model": "qwen.qwen3-coder-next" }, "expect": { "reason": "model_locked", "model": "qwen.qwen3-coder-next" } },
    { "record": { "reason": "model_locked", "model": "us.moonshotai.kimi-k3" }, "expect": { "reason": "model_locked", "model": "us.moonshotai.kimi-k3" } },
    { "record": { "reason": "window_limit" }, "expect": { "reason": "window_limit" } },
