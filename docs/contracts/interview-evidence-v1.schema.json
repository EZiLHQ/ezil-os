                }
              ]
            },
            "reasoning": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "cacheWrite",
            "cachedInput",
            "input",
            "output",
            "reasoning"
          ]
        },
        "ttftMs": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "totalMs": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "const": "subject_window"
        }
      },
      "required": [
        "attribution",
        "modelAlias",
        "outcome",
        "requestId",
        "tokens",
        "totalMs",
        "ttftMs",
        "upstreamModel"
      ]
    },
    "data:prompt.captured": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
