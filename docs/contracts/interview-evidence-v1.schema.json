        "truncated": {
          "type": "boolean"
        },
        "reqBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "respBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "purged": {
