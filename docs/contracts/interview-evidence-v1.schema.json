      ]
    },
    "data:presence.idle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bucket": {
          "enum": [
            "<15s",
            "15-60s",
            "1-5m",
            ">5m"
          ]
        }
      },
      "required": [
        "bucket"
      ]
    },
    "data:session.heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "data:agent.turn_start": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "#/$defs/anyUuid"
        },
        "derived": {
          "const": true
        }
      },
      "required": [
        "derived",
        "requestId"
      ]
    },
    "data:agent.turn_end": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "$ref": "#/$defs/anyUuid"
        },
        "gatewayRequestId": {
          "oneOf": [
            {
              "$ref": "#/$defs/anyUuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelAlias": {
          "type": "string",
          "pattern": "^(?:unknown|[A-Za-z][A-Za-z0-9_.:-]{0,127})$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outcome": {
          "enum": [
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "toolCalls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "search": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "write": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "other": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "other",
            "read",
            "search",
            "write"
          ]
        }
      },
      "required": [
        "durationMs",
        "gatewayRequestId",
        "modelAlias",
        "outcome",
        "requestId",
        "toolCalls"
      ]
    },
