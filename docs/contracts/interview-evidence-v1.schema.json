{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ezil.work/contracts/interview-evidence-v1.schema.json",
  "title": "ezil.interview.event.v1 and ezil.interview.timeline.v1",
  "description": "Frozen for RUN-1121 WS1. Validate an event against #/$defs/event and a timeline against #/$defs/timeline. Cross-record rules (gapless seq per source, ordering, interviewId agreement) are in interview-evidence-v1.md §2/§9 and the vectors; JSON Schema cannot express them.",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "anyUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "bigint": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "canonicalURL": {
      "type": "string",
      "pattern": "^https://git-qa\\.ezil\\.work/[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,98}[A-Za-z0-9])?\\.git$",
      "maxLength": 256
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interviewId": {
          "$ref": "#/$defs/uuid"
        },
        "repositoryId": {
          "$ref": "#/$defs/bigint"
        },
        "canonicalURL": {
          "$ref": "#/$defs/canonicalURL"
        },
        "osUserId": {
          "oneOf": [
            {
              "$ref": "#/$defs/anyUuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "ezilIdSubject": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "worksAccountId": {
          "$ref": "#/$defs/bigint"
        }
      },
      "required": [
        "canonicalURL",
        "ezilIdSubject",
        "interviewId",
        "osUserId",
        "repositoryId",
        "worksAccountId"
      ]
    },
    "data:repo.created": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositoryId": {
          "$ref": "#/$defs/bigint"
        },
        "canonicalURL": {
          "$ref": "#/$defs/canonicalURL"
        },
        "handle": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        }
      },
      "required": [
        "canonicalURL",
        "handle",
        "name",
        "repositoryId"
      ]
    },
    "data:repo.seeded": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headSha": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "headSha"
      ]
    },
    "data:git.grant_issued": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "read",
            "write"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "^[a-z][a-z_]{0,63}$"
        },
        "expiresAt": {
          "$ref": "#/$defs/at"
        },
        "presenceGated": {
          "const": true
        }
      },
      "required": [
        "expiresAt",
        "presenceGated",
        "reason",
        "scope"
      ]
    },
    "data:git.push": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^refs/heads/[A-Za-z0-9._/-]{1,240}$"
        },
        "before": {
          "$ref": "#/$defs/sha"
        },
        "after": {
          "$ref": "#/$defs/sha"
        },
        "commits": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sha": {
                "$ref": "#/$defs/sha"
              },
              "message": {
                "type": "string",
                "maxLength": 65536
              },
              "messageTruncated": {
                "type": "boolean"
              },
              "author": {
                "type": "string",
                "maxLength": 512
              },
              "committedAt": {
                "$ref": "#/$defs/at"
              }
            },
            "required": [
              "author",
              "committedAt",
              "message",
              "messageTruncated",
              "sha"
            ]
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "after",
        "before",
        "commits",
        "ref",
        "truncated"
      ]
    },
    "data:repo.frozen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "data:consent.accepted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "noticeVersion": {
          "const": 1
        },
        "noticeSha256": {
          "const": "a73e2521409a299375aeac8dfb21d95a7daab7e788405d6dda4e4a064f0e7336"
        }
      },
      "required": [
        "noticeSha256",
        "noticeVersion"
      ]
    },
    "data:interview.started": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "data:computer.opened": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "computerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "computerId"
      ]
    },
    "data:tab.visibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "visible",
            "hidden"
          ]
        }
      },
      "required": [
