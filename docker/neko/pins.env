# EZiL OS — pinned upstream inputs for the Neko + VS Code BASE image.
#
# Plain `KEY=value`, no quoting, no substitution, no `export` — sourced by
# `docker/neko/build.sh` and by `.github/workflows/image.yml`. Committed and
# public on purpose: two public repo URLs and two public commit SHAs, no
# secret. See ATTRIBUTIONS.md §2 for the licence verification of both repos
# (neko: Apache-2.0, verified; neko-apps: UNVERIFIED — build-time-only input,
# nothing from its output ships) before changing either SHA.
#
# This is the BARE base only — no EZiL branding. `worker/assets/neko-branding/
# Dockerfile` overlays that on top under a `-ezil-brandN` tag, and THAT is
# what `worker/Dockerfile`'s `ARG NEKO_IMAGE` actually FROMs (see the 🔴
# comment there: the bare base lacks the mobile keyboard and the
# black-picture detector). Changing a SHA here changes the base image
# identity end to end — the tag `docker/neko/build.sh` derives, the overlay
# tag `worker/Dockerfile` pins, and `deploy/images.env`'s `EZIL_NEKO_TAG` all
# encode these same two short SHAs and must be bumped together, in the same
# commit as a new overlay build (`worker/Dockerfile`'s own header explains
# why: a stale overlay suffix is invisible to its test).

NEKO_REPO=https://github.com/m1k1o/neko.git
NEKO_SHA=d74052bb844c43a0cc3c2386d083f7505dc483a2
NEKO_APPS_REPO=https://github.com/m1k1o/neko-apps.git
NEKO_APPS_SHA=049931d7638f9db8598f29c369d2fb7cd2c6e4b4

# Upstream base that neko-apps' own `build --application vscode` builds on top
# of (m1k1o/neko's published Go server + client base image).
#
# 🔴 PINNED BY DIGEST, NOT BY THE FLOATING `:latest` TAG.
# `:latest` moves upstream at any time, underneath a build this repository
# calls reproducible by SHA. MEASURED, not assumed: the digest below is the
# exact multi-arch index digest `docker buildx imagetools inspect
# ghcr.io/m1k1o/neko/base:latest` reported on 2026-09-04, which matches the
# digest CI's own `docker pull ghcr.io/m1k1o/neko/base:latest` resolved to in
# run 33858675382's `neko-base` job log (line: "Digest:
# sha256:20806497c78de64700cb7befa674dbdc6bc4e8f0848a3dc911f0878a6726fa36") —
# i.e. `:latest` had not moved between that CI run and this pin being written:
# both the CI-recorded value and a fresh `imagetools inspect` run today agree.
# `:latest` can move at any time upstream, though (the point of pinning it at
# all) — re-check with the same command below before assuming a future
# rebuild from `:latest` would still produce these exact bytes.
#
# This is the top-level OCI image INDEX digest (covers amd64/arm64/attestation
# manifests), not the amd64-only manifest digest nested under it — `docker
# pull`/`FROM`/neko-apps' own `./build --base_image` all accept either form and
# resolve the right platform from an index; using the index digest keeps this
# reference identical to the exact string `docker pull ...:latest` printed.
# Re-pin with:
#   docker buildx imagetools inspect ghcr.io/m1k1o/neko/base:latest | grep ^Digest
NEKO_BASE_IMAGE=ghcr.io/m1k1o/neko/base@sha256:20806497c78de64700cb7befa674dbdc6bc4e8f0848a3dc911f0878a6726fa36

# Chrome (installed later, in worker/Dockerfile) has no arm64 Linux build, so
# amd64 is the only target this repository builds or ships.
NEKO_TARGET_ARCH=amd64
