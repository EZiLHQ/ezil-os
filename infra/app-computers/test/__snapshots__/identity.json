  "DeployRole885297C3": {
    "Type": "AWS::IAM::Role",
    "Properties": {
      "AssumeRolePolicyDocument": {
        "Statement": [
          {
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
              "StringEquals": {
                "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                "token.actions.githubusercontent.com:sub": "repo:<org>@1000/<repo>@2000:environment:aws-pilot"
              }
            },
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
            }
          }
        ],
        "Version": "2012-10-17"
      },
      "Description": "GitHub OIDC deploy (environment aws-pilot): change sets via the execution role",
      "MaxSessionDuration": 3600,
      "Path": "/ezil/identity/",
      "PermissionsBoundary": {
        "Ref": "BoundaryEA298153"
      },
      "Policies": [
        {
          "PolicyDocument": {
            "Statement": [
              {
                "Action": "cloudformation:CreateChangeSet",
                "Condition": {
                  "ArnEquals": {
                    "cloudformation:RoleArn": "arn:aws:iam::123456789012:role/ezil/identity/ezil-pilot-cfn-exec"
                  }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:cloudformation:ap-south-1:123456789012:stack/ezil-pilot-*/*"
              },
              {
                "Action": [
                  "cloudformation:DescribeChangeSet",
                  "cloudformation:ExecuteChangeSet",
                  "cloudformation:DeleteChangeSet",
                  "cloudformation:DescribeStacks",
                  "cloudformation:DescribeStackEvents",
                  "cloudformation:GetTemplate",
                  "cloudformation:GetTemplateSummary",
                  "cloudformation:ListStackResources"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:cloudformation:ap-south-1:123456789012:stack/ezil-pilot-*/*"
              },
              {
                "Action": "cloudformation:ValidateTemplate",
                "Effect": "Allow",
                "Resource": "*"
              },
              {
                "Action": "iam:PassRole",
                "Condition": {
                  "StringEquals": {
                    "iam:PassedToService": "cloudformation.amazonaws.com"
                  }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:iam::123456789012:role/ezil/identity/ezil-pilot-cfn-exec"
              },
              {
                "Action": [
                  "s3:PutObject",
                  "s3:GetObject"
                ],
                "Effect": "Allow",
                "Resource": [
                  "arn:aws:s3:::ezil-pilot-deploy-assets-123456789012/assets/*",
                  "arn:aws:s3:::ezil-pilot-deploy-assets-123456789012/templates/*"
                ]
              },
              {
                "Action": [
                  "s3:ListBucket",
                  "s3:GetBucketLocation"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::ezil-pilot-deploy-assets-123456789012"
              }
            ],
            "Version": "2012-10-17"
          },
          "PolicyName": "deploy"
        }
      ],
      "RoleName": "ezil-pilot-deploy"
    }
  }
}
