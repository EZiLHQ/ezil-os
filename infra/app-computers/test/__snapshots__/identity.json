{
  "BoundaryEA298153": {
    "Type": "AWS::IAM::ManagedPolicy",
    "Properties": {
      "Description": "EZiL permission boundary (AWS-COMPUTERS.md §5)",
      "ManagedPolicyName": "ezil-pilot-boundary",
      "Path": "/ezil/identity/",
      "PolicyDocument": {
        "Statement": [
          {
            "Action": "*",
            "Effect": "Allow",
            "Resource": "*",
            "Sid": "WithinBoundary"
          },
          {
            "NotAction": [
              "iam:*",
              "sts:*",
              "budgets:*",
              "cloudfront:*",
              "route53:*",
              "support:*",
              "health:*"
            ],
            "Condition": {
              "StringNotEquals": {
                "aws:RequestedRegion": "ap-south-1"
              }
            },
            "Effect": "Deny",
            "Resource": "*",
            "Sid": "RegionLock"
          },
          {
            "Action": [
              "iam:CreateUser",
              "iam:CreateAccessKey",
              "iam:CreateLoginProfile",
              "iam:DeleteRolePermissionsBoundary",
              "iam:DeleteUserPermissionsBoundary"
            ],
            "Effect": "Deny",
            "Resource": "*",
            "Sid": "NoUsersOrKeysOrBoundaryRemoval"
          },
          {
            "Action": [
              "iam:CreateRole",
              "iam:PutRolePermissionsBoundary"
            ],
            "Condition": {
              "StringNotEquals": {
                "iam:PermissionsBoundary": "arn:aws:iam::123456789012:policy/ezil/identity/ezil-pilot-boundary"
              }
            },
            "Effect": "Deny",
            "Resource": "*",
            "Sid": "RolesCarryThisBoundary"
          },
          {
            "Action": [
              "iam:CreateRole",
              "iam:DeleteRole",
              "iam:UpdateRole",
              "iam:UpdateRoleDescription",
              "iam:UpdateAssumeRolePolicy",
              "iam:PutRolePolicy",
              "iam:DeleteRolePolicy",
              "iam:AttachRolePolicy",
              "iam:DetachRolePolicy",
              "iam:PutRolePermissionsBoundary",
              "iam:TagRole",
              "iam:UntagRole",
              "iam:CreatePolicy",
              "iam:DeletePolicy",
              "iam:CreatePolicyVersion",
              "iam:DeletePolicyVersion",
              "iam:SetDefaultPolicyVersion",
              "iam:TagPolicy",
              "iam:UntagPolicy",
              "iam:CreateInstanceProfile",
              "iam:AddRoleToInstanceProfile"
            ],
            "Effect": "Deny",
            "NotResource": [
              "arn:aws:iam::123456789012:role/ezil/pilot/*",
              "arn:aws:iam::123456789012:policy/ezil/pilot/*"
            ],
            "Sid": "IamOnlyUnderWorkloadPath"
          },
          {
            "Action": [
              "ec2:DeleteVolume",
              "ec2:DeleteSnapshot",
              "ec2:DetachVolume",
              "ec2:DeleteTags"
            ],
            "Effect": "Deny",
            "Resource": "*",
            "Sid": "NoStorageDeletionOrDetach"
          },
          {
            "Action": [
              "organizations:Accept*",
              "organizations:Attach*",
              "organizations:Create*",
              "organizations:Decline*",
              "organizations:Delete*",
              "organizations:Deregister*",
              "organizations:Detach*",
              "organizations:Disable*",
              "organizations:Enable*",
              "organizations:Invite*",
              "organizations:Leave*",
              "organizations:Move*",
              "organizations:Register*",
              "organizations:Remove*",
              "organizations:Tag*",
              "organizations:Untag*",
              "organizations:Update*",
              "account:Accept*",
              "account:Close*",
              "account:Delete*",
              "account:Disable*",
              "account:Enable*",
              "account:Put*",
              "account:Start*",
              "aws-portal:Modify*",
              "billing:Create*",
              "billing:Delete*",
              "billing:Put*",
              "billing:Update*",
              "payments:*",
              "tax:Batch*",
              "tax:Delete*",
              "tax:Put*",
              "ce:Create*",
              "ce:Delete*",
              "ce:Update*"
            ],
            "Effect": "Deny",
            "Resource": "*",
            "Sid": "NoAccountOrgBillingWrites"
          }
        ],
        "Version": "2012-10-17"
      }
    }
  },
  "ExecRole372216D6": {
    "Type": "AWS::IAM::Role",
    "Properties": {
      "AssumeRolePolicyDocument": {
        "Statement": [
          {
            "Action": "sts:AssumeRole",
            "Condition": {
              "StringEquals": {
                "aws:SourceAccount": "123456789012"
              }
            },
            "Effect": "Allow",
            "Principal": {
