                  "kms:ListAliases"
                ],
                "Condition": {
                  "StringEquals": {
                    "aws:RequestedRegion": "ap-south-1"
                  }
                },
                "Effect": "Allow",
                "Resource": "*"
              },
              {
                "Action": [
                  "kms:DescribeKey",
                  "kms:GetKeyPolicy",
                  "kms:PutKeyPolicy",
                  "kms:EnableKeyRotation",
                  "kms:GetKeyRotationStatus",
