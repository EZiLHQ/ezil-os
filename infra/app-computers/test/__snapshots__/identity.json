                  "cloudwatch:ListTagsForResource"
                ],
                "Condition": {
                  "StringEquals": {
                    "aws:RequestedRegion": "ap-south-1"
                  }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:cloudwatch:ap-south-1:123456789012:alarm:*"
