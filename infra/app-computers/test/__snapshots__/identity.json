                "Condition": {
                  "StringEquals": {
                    "aws:RequestedRegion": "ap-south-1"
                  }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:sns:ap-south-1:123456789012:ezil-pilot-*"
