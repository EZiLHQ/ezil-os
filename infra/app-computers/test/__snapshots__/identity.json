              {
                "Action": "s3:GetObject",
                "Effect": "Allow",
                "Resource": "arn:aws:s3:::ezil-pilot-deploy-assets-123456789012/assets/*"
              },
              {
                "Action": [
                  "iam:CreateRole",
                  "iam:PutRolePermissionsBoundary"
                ],
                "Condition": {
                  "StringEquals": {
                    "iam:PermissionsBoundary": "arn:aws:iam::123456789012:policy/ezil/identity/ezil-pilot-boundary"
                  }
                },
                "Effect": "Allow",
                "Resource": "arn:aws:iam::123456789012:role/ezil/pilot/*"
              },
              {
                "Action": [
                  "iam:GetRole",
                  "iam:DeleteRole",
                  "iam:UpdateRole",
                  "iam:UpdateAssumeRolePolicy",
                  "iam:PutRolePolicy",
                  "iam:GetRolePolicy",
                  "iam:DeleteRolePolicy",
                  "iam:TagRole",
                  "iam:UntagRole",
                  "iam:ListRoleTags"
                ],
                "Effect": "Allow",
                "Resource": "arn:aws:iam::123456789012:role/ezil/pilot/*"
              },
              {
                "Action": [
                  "iam:CreatePolicy",
                  "iam:DeletePolicy",
                  "iam:GetPolicy",
                  "iam:GetPolicyVersion",
                  "iam:CreatePolicyVersion",
                  "iam:DeletePolicyVersion",
                  "iam:ListPolicyVersions",
