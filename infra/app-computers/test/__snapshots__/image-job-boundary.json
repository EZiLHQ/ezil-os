[
  {
    "Action": [
      "ec2:Purchase*",
      "ec2:AllocateHosts",
      "ec2:ModifyHosts",
      "ec2:CreateCapacityReservation*",
      "ec2:CreateReservedInstancesListing",
      "ec2:AcceptReservedInstancesExchangeQuote",
      "ec2:RequestSpot*",
      "ec2:CreateFleet",
      "savingsplans:*",
      "rds:*",
      "elasticache:*",
      "redshift:*",
      "es:*",
      "dynamodb:*",
      "aws-marketplace:*",
      "ec2:DeleteVolume",
      "ec2:DeleteSnapshot",
      "ec2:DetachVolume",
      "ec2:DeleteTags",
      "ec2:ModifyInstanceAttribute",
      "iam:*",
      "sts:*",
      "organizations:*",
      "account:*",
      "aws-portal:*",
      "billing:*",
      "payments:*",
      "tax:*",
      "ce:*",
      "route53:*",
      "route53domains:*",
      "cloudfront:*",
      "budgets:*",
      "cloudwatch:*",
      "ec2:ModifyInstanceMetadataOptions",
      "iam:PassRole",
      "ec2:CopySnapshot",
      "ec2:ModifySnapshotAttribute",
      "ec2:ResetSnapshotAttribute",
      "ec2:DescribeInstanceAttribute"
    ],
    "Effect": "Deny",
    "Resource": "*"
  },
  {
    "NotAction": "iam:*",
    "Condition": {
      "StringNotEquals": {
        "aws:RequestedRegion": "ap-south-1"
      }
    },
    "Effect": "Deny",
    "Resource": "*"
  },
  {
    "Action": "lambda:InvokeFunction",
    "Effect": "Allow",
    "Resource": "arn:aws:lambda:ap-south-1:123456789012:function:ezil-pilot-*"
  },
  {
    "Action": [
      "kms:Encrypt",
      "kms:Decrypt",
      "kms:ReEncryptFrom",
      "kms:ReEncryptTo",
      "kms:GenerateDataKey",
      "kms:GenerateDataKeyWithoutPlaintext",
      "kms:DescribeKey",
      "kms:CreateGrant"
    ],
    "Condition": {
      "StringEquals": {
        "aws:ResourceTag/ezil:namespace": "pilot"
      }
    },
    "Effect": "Allow",
    "Resource": "arn:aws:kms:ap-south-1:123456789012:key/*"
  },
  {
    "Action": [
      "logs:CreateLogDelivery",
      "logs:GetLogDelivery",
      "logs:UpdateLogDelivery",
      "logs:DeleteLogDelivery",
      "logs:ListLogDeliveries",
      "logs:PutResourcePolicy",
      "logs:DescribeResourcePolicies",
      "logs:DescribeLogGroups"
    ],
    "Effect": "Allow",
    "Resource": "*"
  },
  {
    "Action": [
      "ec2:StopInstances",
      "ec2:TerminateInstances"
    ],
    "Condition": {
      "StringEquals": {
        "aws:RequestedRegion": "ap-south-1",
        "ec2:ResourceTag/ezil:managed-by": "app-computer-platform",
        "ec2:ResourceTag/ezil:stage": "pilot"
      }
    },
    "Effect": "Allow",
    "Resource": "arn:aws:ec2:ap-south-1:123456789012:instance/*"
  },
  {
    "Action": "ec2:CreateSnapshot",
    "Condition": {
      "StringEquals": {
        "aws:RequestedRegion": "ap-south-1",
        "ec2:ResourceTag/ezil:managed-by": "app-computer-platform",
        "ec2:ResourceTag/ezil:stage": "pilot",
        "ec2:ResourceTag/ezil:backup": "pilot"
      },
      "Null": {
        "aws:ResourceTag/ezil:computer-id": "false",
        "aws:ResourceTag/ezil:pool": "true"
      }
    },
    "Effect": "Allow",
    "Resource": "arn:aws:ec2:ap-south-1:123456789012:volume/*"
  },
  {
    "Action": [
      "ec2:CreateSnapshot",
      "ec2:CreateTags"
    ],
    "Condition": {
      "StringEquals": {
        "aws:RequestedRegion": "ap-south-1",
        "aws:RequestTag/ezil:managed-by": "app-computer-platform",
        "aws:RequestTag/ezil:stage": "pilot",
        "aws:RequestTag/ezil:purpose": "pre-rebase"
      },
      "Null": {
        "aws:TagKeys": "false",
        "aws:RequestTag/ezil:computer-id": "false",
        "aws:RequestTag/ezil:source-volume-id": "false",
        "aws:RequestTag/ezil:source-generation": "false",
        "aws:RequestTag/ezil:source-fence-token": "false",
        "aws:RequestTag/ezil:preparation-job-id": "false"
      },
      "ForAllValues:StringEquals": {
        "aws:TagKeys": [
          "ezil:managed-by",
          "ezil:stage",
          "ezil:computer-id",
          "ezil:source-volume-id",
          "ezil:source-generation",
          "ezil:source-fence-token",
          "ezil:preparation-job-id",
          "ezil:purpose"
        ]
      }
    },
    "Effect": "Allow",
    "Resource": "arn:aws:ec2:ap-south-1::snapshot/*"
  },
  {
    "Action": "ec2:CreateVolume",
    "Condition": {
      "StringEquals": {
        "aws:RequestedRegion": "ap-south-1",
        "ec2:ResourceTag/ezil:managed-by": "app-computer-platform",
        "ec2:ResourceTag/ezil:stage": "pilot",
        "ec2:ResourceTag/ezil:purpose": "pre-rebase"
      },
      "Null": {
        "aws:ResourceTag/ezil:preparation-job-id": "false"
      }
    },
    "Effect": "Allow",
    "Resource": "arn:aws:ec2:ap-south-1::snapshot/*"
  },
  {
    "Action": "ec2:CreateVolume",
    "Condition": {
      "StringEquals": {
        "aws:RequestedRegion": "ap-south-1",
        "aws:RequestTag/ezil:managed-by": "app-computer-platform",
        "aws:RequestTag/ezil:stage": "pilot",
        "aws:RequestTag/ezil:backup": "pilot",
        "ec2:VolumeType": "gp3",
        "ec2:AvailabilityZoneId": "aps1-az1"
      },
      "ArnEquals": {
        "ec2:KmsKeyId": "arn:aws:kms:ap-south-1:123456789012:key/11111111-1111-4111-8111-111111111111"
      },
      "Bool": {
        "ec2:Encrypted": "true"
      },
      "NumericGreaterThanEquals": {
        "ec2:VolumeSize": "20"
      },
      "NumericLessThanEquals": {
        "ec2:VolumeSize": "100"
      },
      "Null": {
        "aws:RequestTag/ezil:computer-id": "false"
      }
    },
    "Effect": "Allow",
    "Resource": "arn:aws:ec2:ap-south-1:123456789012:volume/*"
  },
  {
    "Action": "ec2:CreateTags",
    "Condition": {
      "StringEquals": {
        "aws:RequestedRegion": "ap-south-1",
        "aws:RequestTag/ezil:managed-by": "app-computer-platform",
        "aws:RequestTag/ezil:stage": "pilot",
        "aws:RequestTag/ezil:backup": "pilot",
        "ec2:CreateAction": "CreateVolume"
      },
      "Null": {
        "aws:TagKeys": "false",
        "aws:RequestTag/ezil:computer-id": "false",
        "aws:RequestTag/ezil:generation": "false",
        "aws:RequestTag/ezil:fence-token": "false",
        "aws:RequestTag/ezil:restored-from-snapshot": "false",
        "aws:RequestTag/ezil:original-volume-id": "false",
        "aws:RequestTag/ezil:recovery-job-id": "false"
      },
      "ForAllValues:StringEquals": {
        "aws:TagKeys": [
          "ezil:managed-by",
          "ezil:stage",
          "ezil:computer-id",
          "ezil:generation",
          "ezil:fence-token",
          "ezil:backup",
          "ezil:restored-from-snapshot",
          "ezil:original-volume-id",
          "ezil:recovery-job-id"
        ]
      }
    },
    "Effect": "Allow",
    "Resource": "arn:aws:ec2:ap-south-1:123456789012:volume/*"
  },
  {
    "Action": "ec2:CreateTags",
    "Condition": {
      "StringNotEquals": {
        "ec2:CreateAction": "CreateSnapshot"
      }
    },
    "Effect": "Deny",
    "Resource": "arn:aws:ec2:ap-south-1::snapshot/*"
  },
  {
    "Action": "ec2:CreateTags",
    "Condition": {
      "ForAnyValue:StringEquals": {
        "aws:TagKeys": [
          "ezil:backup",
          "ezil:managed-by",
          "ezil:stage",
          "ezil:computer-id",
          "ezil:source-volume-id",
          "ezil:source-generation",
          "ezil:source-fence-token",
          "ezil:preparation-job-id",
          "ezil:purpose",
          "ezil:generation",
          "ezil:fence-token",
          "ezil:restored-from-snapshot",
          "ezil:original-volume-id",
          "ezil:recovery-job-id"
        ]
      },
      "Null": {
        "ec2:CreateAction": "true"
      }
    },
    "Effect": "Deny",
    "Resource": "*"
  }
]
