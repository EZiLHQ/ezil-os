{
  "name": "@ezil-os/app-computer-infra",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "synth": "cdk synth --strict",
    "synth:lifecycle": "cdk synth --strict --app \"npx tsx bin/lifecycle.ts\"",
