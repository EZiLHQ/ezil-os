[Unit]
Description=EZiL: host edge (gateway contract GW-2/GW-3) - cloudflared's only ingress target; verifies gw1, relays presence and control
Requires=ezil-enroll.service ezil-agent.service
After=ezil-enroll.service ezil-agent.service
[Service]
Type=simple
Environment=EZIL_HOST_CONFIG=/etc/ezil-host/agent.json
UMask=0077
ExecStart=/opt/ezil-host/bin/ezil-host-agent edge
TimeoutStopSec=15
