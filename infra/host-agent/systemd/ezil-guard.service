[Unit]
Description=EZiL: mount the data volume by volume id + fs UUID (nosuid,nodev) and run the C-4 marker guard
Requires=ezil-lease.service
After=ezil-lease.service
# A guard that crashes (in pool mode, the long-lived pool agent waiting for a claim) is restarted,
# at most 3 starts per 15 minutes (R2-4: one failure must not end a warm host's pool agent for
# good). Exit 2 is a refusal (a C-4 marker mismatch, a refused claim) and is never restarted.
# A warm desktop's readiness miss, or an app outage while it waits, is not a failure at all:
# pool.py keeps the host.
StartLimitIntervalSec=900
StartLimitBurst=3
[Service]
Type=oneshot
RemainAfterExit=yes
# Pool mode warms a clean desktop and waits here until this single-use host is claimed.
TimeoutStartSec=infinity
Environment=EZIL_HOST_CONFIG=/etc/ezil-host/agent.json
UMask=0077
ExecStart=/opt/ezil-host/bin/ezil-host-agent guard
ExecStop=/opt/ezil-host/bin/ezil-host-agent data-down
Restart=on-failure
# direct (systemd >= 254; noble ships 255): the auto-restart goes straight back to activating,
# never through failed. With the default (normal) a failed oneshot start fails the start job of
# every unit that Requires= this one (host-clean, overlay, enroll, agent, edge, cloudflared,
# desktop), and a later successful run never starts them again (see ezil-enroll.service).
RestartMode=direct
RestartSec=30
RestartPreventExitStatus=2
