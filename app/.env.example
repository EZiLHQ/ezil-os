# Copy to .env.local and fill in real values. Never commit the filled-in file.

# --- Database (Supabase Postgres, via postgres.js / Drizzle) ---------------
SUPABASE_DATABASE_URL=

# --- Supabase Auth (browser-safe) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Marketplace API --------------------------------------------------------
# Leave disabled until the reviewed 0003 and 0004 migrations are applied to
# this exact database. The default is false if omitted.
EZIL_APP_MARKETPLACE_API_ENABLED=false
# Enable only after an inspection job consumer is deployed and observed.
EZIL_APP_SUBMISSION_INTAKE_ENABLED=false

# --- Cloudflare Guacamole/Neko Worker (the computer's desktop provider) ----
# CLOUDFLARE_GUACAMOLE_WORKER_URL must be a host on the Worker's preview zone
# (PREVIEW_ZONE_ROOT = ezil.org) that is matched by one of the narrow suffix
# routes in worker/wrangler.toml (*-app / *-desktop / *-nekodesktop).
# NOT a *.workers.dev URL: the Worker derives each sandbox's preview hostname
# from the inbound request's own Host, and @cloudflare/sandbox refuses to
# expose a port on a *.workers.dev host ("Port exposure requires a custom
# domain"), so every desktop boot fails ~26s in. See worker/README.md.
CLOUDFLARE_GUACAMOLE_WORKER_URL=https://api-desktop.ezil.org
# CLOUDFLARE_GUACAMOLE_HMAC_SECRET must byte-match the Worker's own
# SANDBOX_HMAC_SECRET (see worker/wrangler.toml) — both sides sign/verify
# with the same shared secret.
CLOUDFLARE_GUACAMOLE_HMAC_SECRET=

# --- Telemetry (see docs/telemetry.md) --------------------------------------
# Guards GET /api/cron/telemetry-maintenance (the hourly retention job).
# UNSET BY DEFAULT — leaving it empty makes that route 404 rather than run
# unauthenticated (fail closed). Vercel Cron sends this as a Bearer token
# automatically once both this and vercel.json's cron entry are configured.
CRON_SECRET=
# Comma-separated email allow-list for the /admin/telemetry review page.
# UNSET BY DEFAULT — leaving it empty makes that page unreachable by anyone,
# never reachable by everyone signed in.
TELEMETRY_ADMIN_EMAILS=
