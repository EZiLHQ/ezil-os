# Copy to .env.local and fill in real values. Never commit the filled-in file.

# --- Database (Supabase Postgres, via postgres.js / Drizzle) ---------------
SUPABASE_DATABASE_URL=

# --- Supabase Auth (browser-safe) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudflare Guacamole/Neko Worker (the computer's desktop provider) ----
# CLOUDFLARE_GUACAMOLE_WORKER_URL must be a host on the Worker's preview zone
# (PREVIEW_ZONE_ROOT = ezil.org) that is matched by one of the narrow suffix
# routes in worker/wrangler.toml (*-app / *-desktop / *-nekodesktop).
# NOT a *.workers.dev URL: the Worker derives each sandbox's preview hostname
# from the inbound request's own Host, and @cloudflare/sandbox refuses to
# expose a port on a *.workers.dev host ("Port exposure requires a custom
# domain"), so every desktop boot fails ~26s in. See worker/README.md.
CLOUDFLARE_GUACAMOLE_WORKER_URL=https://api-desktop.ezil.org
# CLOUDFLARE_GUACAMOLE_HMAC_SECRET must byte-match the Worker's own
# SANDBOX_HMAC_SECRET (see worker/wrangler.toml) — both sides sign/verify
# with the same shared secret.
CLOUDFLARE_GUACAMOLE_HMAC_SECRET=

# --- Telemetry (see docs/telemetry.md) --------------------------------------
# Guards GET /api/cron/telemetry-maintenance (the hourly retention job).
# UNSET BY DEFAULT — leaving it empty makes that route 404 rather than run
# unauthenticated (fail closed). Vercel Cron sends this as a Bearer token
# automatically once both this and vercel.json's cron entry are configured.
CRON_SECRET=
# Comma-separated email allow-list for the /admin/telemetry review page.
# UNSET BY DEFAULT — leaving it empty makes that page unreachable by anyone,
# never reachable by everyone signed in.
TELEMETRY_ADMIN_EMAILS=

# --- Universe project repositories (app/src/server/works/project-repo.ts) ---
# The bare https origin of Universe 2.0, whose /internal/project-repositories/
# open answers "may this person open this project's repository, and with what"
# (staging: https://universe-staging.ezil.work). UNSET BY DEFAULT: opening a
# project in Code then answers project_repo_unavailable.
UNIVERSE_PROJECT_REPO_ORIGIN=

# --- Delegated computer reads (app/src/server/api/delegation-auth.ts) ---
# EZiL MCP reading a person's computers with `Authorization: EZiL-Delegation`,
# computer.list / computer.get by GET only. OFF unless exactly "enabled"; while
# off, misconfigured or failing, a delegation is rejected (never a cookie
# fallback). Enable only after independently qualifying the actual MCP origin,
# OS audience, client ids and public keys, and applying the reviewed replay table
# (app/drizzle/0030_delegation_replay.sql). No values are inferred from requests.
EZIL_DELEGATED_COMPUTER_READS=
# Exact public MCP origin (bare https origin, no trailing slash).
EZIL_DELEGATION_ISSUER=
# This OS deployment's exact canonical origin as the MCP targets it (bare https).
EZIL_DELEGATION_AUDIENCE=
# Pinned public ES256/P-256 JWK set {"keys":[...]}, at most 3 keys, no private members.
EZIL_DELEGATION_PUBLIC_JWKS=
# Exact allow-list of qualified OAuth client ids (comma or space separated).
EZIL_DELEGATION_CLIENT_IDS=

# Staging editor MCP; both base flags require the canonical staging origins.
EZIL_DELEGATED_EDITOR_SESSIONS=
EZIL_EDITOR_BRIDGE=
# Protocol 2 model controls require the matching editor image and additive schema.
EZIL_EDITOR_BRIDGE_CONTROLS=
