{
    "name": "@ezil-os/app",
    "version": "0.1.0",
    "private": true,
    "license": "AGPL-3.0-only",
    "scripts": {
        "dev": "bun run dev:doctor && next dev --webpack --hostname 127.0.0.1",
        "dev:setup": "bun --no-env-file scripts/local-web.ts setup",
        "dev:doctor": "bun --no-env-file scripts/local-web.ts doctor",
        "dev:verify": "bun --no-env-file scripts/local-web.ts verify",
        "dev:stop": "bun --no-env-file scripts/local-web.ts stop",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:db:computer-runtime": "node tests/computer-runtime-db.mjs",
        "test:db:app-marketplace": "node tests/app-marketplace-db.mjs",
        "test:db:marketplace-api": "bun --no-env-file tests/marketplace-api-db.ts",
        "test:db:runtime-commands": "node tests/app-runtime-commands-db.mjs",
        "test:db:runtime-api": "bun --no-env-file tests/app-runtime-api-db.ts",
        "test:db:runtime-dispatcher": "bun --no-env-file tests/app-runtime-dispatcher-db.ts",
        "test:db:computer-configurations": "bun --no-env-file tests/computer-configurations-db.ts",
        "test:db:configuration-producer": "bun --no-env-file tests/computer-configuration-producer-db.ts",
        "test:db:configuration-delivery": "bun --no-env-file tests/configuration-delivery-db.ts",
        "test:db:configuration-authority": "bun --no-env-file tests/configuration-authority-db.ts",
        "test:host:configuration": "bun --no-env-file tests/configuration-host-acceptance.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:apply-0001": "node scripts/apply-telemetry-migration.mjs",
        "db:inspect-0002": "node scripts/probe-os-access-schema.mjs",
        "db:apply-0002": "node scripts/apply-os-access-migration.mjs",
        "test:db:lifecycle-intents": "bun --no-env-file tests/computer-lifecycle-intents-db.ts",
        "test:db:lifecycle-consumer": "bun --no-env-file tests/computer-lifecycle-consumer-db.ts",
        "test:db:recovery-intents": "bun --no-env-file tests/computer-recovery-intents-db.ts",
        "test:db:recovery-consumer": "bun --no-env-file tests/computer-recovery-consumer-db.ts"
    },
    "dependencies": {
        "@aws-sdk/client-ec2": "3.1140.0",
        "@aws-sdk/client-s3": "3.1140.0",
        "@aws-sdk/client-secrets-manager": "3.1140.0",
        "@aws-sdk/client-sfn": "3.1140.0",
        "@supabase/ssr": "^0.5.2",
        "@supabase/supabase-js": "^2.47.10",
        "@tanstack/react-query": "^5.62.0",
        "@trpc/client": "^11.0.0",
        "@trpc/next": "^11.0.0",
        "@trpc/react-query": "^11.0.0",
        "@trpc/server": "^11.0.0",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.6.0",
        "motion": "^11.15.0",
        "next": "16.2.12",
        "postgres": "^3.4.5",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "sonner": "^1.7.1",
        "superjson": "^2.2.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@next/env": "16.2.12",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "drizzle-kit": "^0.30.1",
        "eslint": "^9",
        "eslint-config-next": "16.2.12",
        "supabase": "2.65.2",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^3.2.6"
    }
}
