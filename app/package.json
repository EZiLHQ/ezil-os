{
    "name": "@ezil-os/app",
    "version": "0.1.0",
    "private": true,
    "license": "AGPL-3.0-only",
    "scripts": {
        "dev": "bun run dev:doctor && next dev --webpack --hostname 127.0.0.1",
        "dev:setup": "bun --no-env-file scripts/local-web.ts setup",
        "dev:doctor": "bun --no-env-file scripts/local-web.ts doctor",
        "dev:verify": "bun --no-env-file scripts/local-web.ts verify",
        "dev:stop": "bun --no-env-file scripts/local-web.ts stop",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:apply-0001": "node scripts/apply-telemetry-migration.mjs"
    },
    "dependencies": {
        "@supabase/ssr": "^0.12.7",
        "@supabase/supabase-js": "^2.116.0",
        "@tanstack/react-query": "^5.103.1",
        "@trpc/client": "^11.19.0",
        "@trpc/next": "^11.19.0",
        "@trpc/react-query": "^11.19.0",
        "@trpc/server": "^11.19.0",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.8.3",
        "motion": "^11.15.0",
        "next": "16.3.5",
        "postgres": "^3.4.5",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "sonner": "^1.7.1",
        "superjson": "^2.2.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@next/env": "16.3.5",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9",
        "eslint-config-next": "16.3.5",
        "supabase": "2.117.0",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^3.2.6"
    }
}
